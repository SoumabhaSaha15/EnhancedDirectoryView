{
  "manifest_version": 3,
  "name": "EnhancedDirectoryView",
  "version": "1.0.0",
  "description": "This extension is based on existing project by Federico link:- https://github.com/federicobrancasi",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "content_scripts": [
    {
      "css": [
        "index.css"
      ],
      "js": [
        "main.ts"
      ],
      "matches": [
        "file://*"
      ]
    }
  ],
  "author": "soumabhasaha1509+github@gmail.com",
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "file.svg",
        "folder.svg"
      ],
      "matches": [
        "file://*"
      ]
    }
  ]
}