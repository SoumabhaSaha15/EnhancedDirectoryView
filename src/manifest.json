{
  "manifest_version": 3,
  "name": "EnhancedDirectoryView",
  "version": "1.0.0",
  "description": "Tailwind + DaisyUI based project that overrides the native file:// directory listing.",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "content_scripts": [
    {
      "css": [
        "index.css"
      ],
      "js": [
        "main.ts"
      ],
      "matches": [
        "file:///*"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "soumabhasaha1509+github@gmail.com",
  "host_permissions": [
    "file:///*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "file.svg",
        "folder.svg"
      ],
      "matches": [
        "file:///*"
      ]
    }
  ]
}