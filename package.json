{
  "name": "EnhancedDirectoryView",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "icon:16": "sharp -i public/folder.svg -o public/icon/16.png resize 16",
    "icon:32": "sharp -i public/folder.svg -o public/icon/32.png resize 32",
    "icon:48": "sharp -i public/folder.svg -o public/icon/48.png resize 48",
    "icon:96": "sharp -i public/folder.svg -o public/icon/96.png resize 96",
    "icon:128": "sharp -i public/folder.svg -o public/icon/128.png resize 128",
    "gen-icons": "pnpm run icon:16 && pnpm run icon:32 && pnpm run icon:48 && pnpm run icon:96 && pnpm run icon:128"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.6",
    "daisyui": "^5.7.27",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "sharp-cli": "^6.1.0",
    "vite-plugin-web-extension": "^4.5.1",
    "webextension-polyfill": "^0.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {}
}